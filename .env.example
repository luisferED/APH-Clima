APH_FONT_DIR=

# Solo para compose.internal.yaml (TLS corporativo por IP, sin dominio publico).
# PUBLIC_ORIGIN=https://172.20.16.195:9443
CORPORATE_CIDRS=
APH_TLS_DIR=

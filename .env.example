# Origen exacto del proxy HTTPS interno, sin barra final.
PUBLIC_ORIGIN=
OPERATOR_USER=
# python scripts/db_admin.py hash-password (sin contrasena predeterminada)
OPERATOR_PASSWORD_HASH=
# APH-Clima/1.0 (correo real o URL de contacto)
MET_USER_AGENT=
